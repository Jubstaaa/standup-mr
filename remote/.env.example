# Public origin claude.ai sees. OAuth metadata and callback URLs derive from it.
PUBLIC_URL=https://standup.ilkerbalcilar.com

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts every stored provider token and webhook URL. Losing it means every
# user has to reconnect; leaking it together with the database leaks tokens.
ENCRYPTION_KEY=

# GitHub App (Settings → Developer settings → GitHub Apps). The slug is the
# app's URL name, used for the "install it on your org" link.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# gitlab.com OAuth application (User settings → Applications), scopes
# read_api and read_user.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Self-hosted GitLab instances with their own OAuth application, comma
# separated as host:client_id:secret. Each gets a "Link a <host> account"
# button. Register the application on the instance with the redirect URI
# https://standup.ilkerbalcilar.com/connect/callback/gitlab/<host> and the
# scopes read_api and read_user.
GITLAB_INSTANCES=

# Extra addresses self-hosted hosts may not resolve to, comma separated —
# the droplet's own public IP, so a "self-hosted GitLab" can't be pointed at it.
BLOCKED_ADDRESSES=
