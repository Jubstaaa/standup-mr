{
    "name": "standup-mr",
    "version": "1.2.0",
    "packageManager": "bun@1.4.4",
    "mcpName": "io.github.Jubstaaa/standup-mr",
    "description": "Standup notes from merge request state, not commit logs.",
    "keywords": [
        "standup",
        "gitlab",
        "github",
        "merge-request",
        "pull-request",
        "cli",
        "mcp"
    ],
    "license": "MIT",
    "author": {
        "name": "İlker Balcılar",
        "email": "ilkerbalcilartr@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Jubstaaa/standup-mr.git"
    },
    "bugs": {
        "url": "https://github.com/Jubstaaa/standup-mr/issues"
    },
    "homepage": "https://github.com/Jubstaaa/standup-mr#readme",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/Jubstaaa"
        },
        {
            "type": "buy_me_a_coffee",
            "url": "https://buymeacoffee.com/jubstaa"
        }
    ],
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "standup": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "skills",
        "mcp/README.md",
        "llms-install.md",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "workspaces": [
        "remote"
    ],
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "bun test",
        "test:tz": "TZ=Europe/Istanbul bun test ./src/dates/dates.tz.istanbul.cases.ts && TZ=America/Los_Angeles bun test ./src/dates/dates.tz.los-angeles.cases.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "tsup",
        "version": "node scripts/sync-versions.mjs && git add -A",
        "audit": "bun audit --audit-level=high",
        "knip": "knip --treat-config-hints-as-errors",
        "duplication": "jscpd",
        "deps:check": "depcruise src mcp remote/src --output-type err-long"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "p-map": "^7.1.1",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.0.0",
        "@types/node": "^22",
        "@typescript/native": "npm:typescript@^7.0.2",
        "dependency-cruiser": "^18.8.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-perfectionist": "^5.5.0",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "jscpd": "^5.4.3",
        "knip": "^6.47.0",
        "prettier": "^3.9.6",
        "tsup": "^9.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.44.0"
    }
}
