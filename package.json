        "build": "tsup",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "tsup"
    },
    "devDependencies": {
        "@types/bun": "^1.0.0",
        "@types/node": "^22.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.5.0"
    },
    "peerDependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "@modelcontextprotocol/sdk": { "optional": true }
