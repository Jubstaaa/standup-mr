    "keywords": ["standup", "gitlab", "merge-request", "cli", "mcp"],
    "license": "MIT",
    "type": "module",
    "engines": { "node": ">=20" },
    "bin": { "standup": "./dist/cli.js" },
    "main": "./dist/index.js",
